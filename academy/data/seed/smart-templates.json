{
  "schema": "cia.smart-template.v1",
  "items": [
    {
      "id": "TPL-RISK-REGISTER",
      "slug": "risk-register",
      "academy": "iso",
      "title": {
        "en": "Risk Register",
        "ar": "سجل المخاطر"
      },
      "summary": {
        "en": "Answer a few questions about your context and criteria, then list risks with likelihood and consequence; the score and rating are calculated for you.",
        "ar": "أجب عن أسئلة قليلة عن سياقك ومعاييرك، ثم سجّل المخاطر بالاحتمال والعاقبة؛ وتُحسب الدرجة والتصنيف تلقائيًا."
      },
      "doc_title": {
        "en": "Risk register",
        "ar": "سجل المخاطر"
      },
      "sections": [
        {
          "id": "ctx",
          "title": {
            "en": "Context",
            "ar": "السياق"
          }
        },
        {
          "id": "crit",
          "title": {
            "en": "Risk criteria",
            "ar": "معايير المخاطر"
          }
        }
      ],
      "questions": [
        {
          "id": "org",
          "section": "ctx",
          "type": "text",
          "label": {
            "en": "Organisation, project or process",
            "ar": "المنظمة أو المشروع أو العملية"
          },
          "required": true
        },
        {
          "id": "scope",
          "section": "ctx",
          "type": "textarea",
          "label": {
            "en": "Scope of this register",
            "ar": "نطاق هذا السجل"
          },
          "required": true,
          "hint": {
            "en": "What is in and out — sites, activities, period.",
            "ar": "ما الداخل وما الخارج — المواقع والأنشطة والفترة."
          }
        },
        {
          "id": "owner",
          "section": "ctx",
          "type": "text",
          "label": {
            "en": "Register owner",
            "ar": "مالك السجل"
          },
          "required": true
        },
        {
          "id": "date",
          "section": "ctx",
          "type": "date",
          "label": {
            "en": "Date prepared",
            "ar": "تاريخ الإعداد"
          },
          "required": true
        },
        {
          "id": "appetite",
          "section": "crit",
          "type": "select",
          "label": {
            "en": "What level of risk needs a treatment plan?",
            "ar": "أي مستوى من الخطر يحتاج خطة معالجة؟"
          },
          "required": true,
          "options": [
            {
              "value": "high",
              "label": {
                "en": "High and above (score 10+)",
                "ar": "مرتفع فأعلى (الدرجة 10+)"
              }
            },
            {
              "value": "medium",
              "label": {
                "en": "Medium and above (score 5+)",
                "ar": "متوسط فأعلى (الدرجة 5+)"
              }
            }
          ]
        },
        {
          "id": "review",
          "section": "crit",
          "type": "select",
          "label": {
            "en": "How often is the register reviewed?",
            "ar": "كم مرة يُراجَع السجل؟"
          },
          "required": true,
          "options": [
            {
              "value": "monthly",
              "label": {
                "en": "Monthly",
                "ar": "شهريًا"
              }
            },
            {
              "value": "quarterly",
              "label": {
                "en": "Quarterly",
                "ar": "ربع سنوي"
              }
            },
            {
              "value": "change",
              "label": {
                "en": "At each significant change",
                "ar": "عند كل تغيير مهم"
              }
            }
          ]
        }
      ],
      "table": {
        "title": {
          "en": "Risks",
          "ar": "المخاطر"
        },
        "min_rows": 1,
        "columns": [
          {
            "id": "ref",
            "type": "text",
            "label": {
              "en": "Ref",
              "ar": "المرجع"
            },
            "required": true,
            "max_length": 20
          },
          {
            "id": "risk",
            "type": "textarea",
            "label": {
              "en": "Risk (cause → event → consequence)",
              "ar": "الخطر (سبب ← حدث ← عاقبة)"
            },
            "required": true
          },
          {
            "id": "owner",
            "type": "text",
            "label": {
              "en": "Owner",
              "ar": "المالك"
            },
            "required": true
          },
          {
            "id": "l",
            "type": "select",
            "label": {
              "en": "Likelihood (1–5)",
              "ar": "الاحتمال (1–5)"
            },
            "required": true,
            "options": [
              {
                "value": "1",
                "label": {
                  "en": "1",
                  "ar": "1"
                }
              },
              {
                "value": "2",
                "label": {
                  "en": "2",
                  "ar": "2"
                }
              },
              {
                "value": "3",
                "label": {
                  "en": "3",
                  "ar": "3"
                }
              },
              {
                "value": "4",
                "label": {
                  "en": "4",
                  "ar": "4"
                }
              },
              {
                "value": "5",
                "label": {
                  "en": "5",
                  "ar": "5"
                }
              }
            ]
          },
          {
            "id": "c",
            "type": "select",
            "label": {
              "en": "Consequence (1–5)",
              "ar": "العاقبة (1–5)"
            },
            "required": true,
            "options": [
              {
                "value": "1",
                "label": {
                  "en": "1",
                  "ar": "1"
                }
              },
              {
                "value": "2",
                "label": {
                  "en": "2",
                  "ar": "2"
                }
              },
              {
                "value": "3",
                "label": {
                  "en": "3",
                  "ar": "3"
                }
              },
              {
                "value": "4",
                "label": {
                  "en": "4",
                  "ar": "4"
                }
              },
              {
                "value": "5",
                "label": {
                  "en": "5",
                  "ar": "5"
                }
              }
            ]
          },
          {
            "id": "score",
            "type": "computed",
            "label": {
              "en": "Score",
              "ar": "الدرجة"
            },
            "required": false,
            "compute": {
              "op": "product",
              "of": [
                "l",
                "c"
              ]
            }
          },
          {
            "id": "rating",
            "type": "computed",
            "label": {
              "en": "Rating",
              "ar": "التصنيف"
            },
            "required": false,
            "compute": {
              "op": "band",
              "of": "score",
              "bands": [
                {
                  "max": 4,
                  "label": {
                    "en": "Low",
                    "ar": "منخفض"
                  }
                },
                {
                  "max": 9,
                  "label": {
                    "en": "Medium",
                    "ar": "متوسط"
                  }
                },
                {
                  "max": 16,
                  "label": {
                    "en": "High",
                    "ar": "مرتفع"
                  }
                },
                {
                  "max": 25,
                  "label": {
                    "en": "Very high",
                    "ar": "مرتفع جدًا"
                  }
                }
              ]
            }
          },
          {
            "id": "treat",
            "type": "select",
            "label": {
              "en": "Treatment option",
              "ar": "خيار المعالجة"
            },
            "required": false,
            "options": [
              {
                "value": "avoid",
                "label": {
                  "en": "Avoid",
                  "ar": "تجنب"
                }
              },
              {
                "value": "likelihood",
                "label": {
                  "en": "Change likelihood",
                  "ar": "تغيير الاحتمال"
                }
              },
              {
                "value": "consequence",
                "label": {
                  "en": "Change consequence",
                  "ar": "تغيير العاقبة"
                }
              },
              {
                "value": "share",
                "label": {
                  "en": "Share",
                  "ar": "مشاركة"
                }
              },
              {
                "value": "retain",
                "label": {
                  "en": "Retain",
                  "ar": "احتفاظ"
                }
              }
            ]
          },
          {
            "id": "action",
            "type": "textarea",
            "label": {
              "en": "Action",
              "ar": "الإجراء"
            },
            "required": false
          },
          {
            "id": "due",
            "type": "date",
            "label": {
              "en": "Due date",
              "ar": "الموعد"
            },
            "required": false
          },
          {
            "id": "status",
            "type": "select",
            "label": {
              "en": "Status",
              "ar": "الحالة"
            },
            "required": false,
            "options": [
              {
                "value": "open",
                "label": {
                  "en": "Open",
                  "ar": "مفتوح"
                }
              },
              {
                "value": "doing",
                "label": {
                  "en": "In progress",
                  "ar": "قيد التنفيذ"
                }
              },
              {
                "value": "done",
                "label": {
                  "en": "Done",
                  "ar": "منجز"
                }
              }
            ]
          }
        ]
      },
      "exports": [
        "csv",
        "xls",
        "doc",
        "print",
        "json"
      ],
      "competencies": [
        "RSK-01",
        "RSK-02"
