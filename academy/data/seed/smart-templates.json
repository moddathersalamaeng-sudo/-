      "labs": [
        "LAB-RISK",
        "LAB-PROJECT-RISK",
        "LAB-FMEA"
      ],
      "courses": [
        "CRS-ISO-RISK",
        "CRS-G-31000",
        "CRS-PM-RISK"
      ],
      "toolkits": [
        "iso31000"
      ],
      "guidance": [
        {
          "en": "Write each risk as cause → event → consequence.",
          "ar": "اكتب كل خطر: سبب ← حدث ← عاقبة."
        },
        {
          "en": "Score = likelihood × consequence on 1–5 scales; bands 1–4, 5–9, 10–16, 17–25.",
          "ar": "الدرجة = الاحتمال × العاقبة على مقياس 1–5؛ والنطاقات 1–4، 5–9، 10–16، 17–25."
        }
      ],
